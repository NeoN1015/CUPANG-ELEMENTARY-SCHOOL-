# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# First principal account (created on first start only)
PRINCIPAL_EMAIL=principal@ces.local
PRINCIPAL_PASSWORD=change-me-now
PRINCIPAL_NAME=School Principal

# Optional: email notification for contact messages (use a Gmail App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_INBOX=
